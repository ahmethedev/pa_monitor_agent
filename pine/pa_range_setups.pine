//@version=6
indicator("MPA | 3A Deviation + 3C SFP v0.1", overlay = true, max_bars_back = 600, max_boxes_count = 80, max_labels_count = 150)

// One excursion, one route: single candle = 3C; outside close then return = 3A.
// Fixed ranges, confirmed source data. Definitions and HTF delay: pullback_range.md.
string G_RANGE = "1. Otomatik range"
string rangeTf = input.timeframe("240", "Range ve HTF kapanis", options = ["60", "120", "240", "1D"], group = G_RANGE)
int rangeWindow = input.int(48, "Range arama penceresi: HTF mum", minval = 16, maxval = 160, group = G_RANGE)
int rangePivot = input.int(2, "HTF temas pivoti: sol / sag", minval = 1, maxval = 6, group = G_RANGE)
int minimumTouches = input.int(3, "Her sinira minimum ayri pivot temasi", minval = 3, maxval = 6, group = G_RANGE)
int touchSpacing = input.int(4, "Ayni sinir temaslari arasi minimum HTF mum", minval = 2, maxval = 20, group = G_RANGE)
int minimumSpan = input.int(16, "Her sinirin ilk / son temasi arasi minimum HTF mum", minval = 5, maxval = 100, group = G_RANGE)
float touchTolerance = input.float(0.20, "Sinir temas toleransi / HTF ATR", minval = 0.01, maxval = 1, step = 0.05, group = G_RANGE)
float minimumWidth = input.float(2.0, "Minimum range genisligi / HTF ATR", minval = 0.5, step = 0.5, group = G_RANGE)
float maximumWidth = input.float(10.0, "Maksimum range genisligi / HTF ATR", minval = 1, step = 0.5, group = G_RANGE)
int rangeLife = input.int(180, "Sabit range omru: HTF mum", minval = 10, maxval = 500, group = G_RANGE)
int rediscoveryWait = input.int(4, "Range bittikten sonra bekleme: HTF mum", minval = 1, maxval = 48, group = G_RANGE)

string G_SETUP = "2. Rotalar ve onay"
bool use3A = input.bool(true, "3A: disarida kapanis -> geri donus -> ChoCh -> ilk retest", group = G_SETUP)
bool use3C = input.bool(true, "3C: tek mum SFP -> hemen sonraki yonlu mum", group = G_SETUP)
string directionInput = input.string("Iki yon", "Yon", options = ["Iki yon", "Long", "Short"], group = G_SETUP)
bool waitHtfClose = input.bool(true, "HAZIR icin sweep / donus mumunun HTF kapanisini bekle", group = G_SETUP)
int internalLen = input.int(2, "Grafik internal pivot sol / sag", minval = 1, maxval = 8, group = G_SETUP)
float sweepMinimum = input.float(0.10, "Minimum sinir tasmasi / grafik ATR", minval = 0, step = 0.05, group = G_SETUP)
float breakBuffer = input.float(0.05, "ChoCh kapanis payi / grafik ATR", minval = 0, step = 0.05, group = G_SETUP)
float breakBody = input.float(0.50, "ChoCh minimum govde / mum araligi", minval = 0.1, maxval = 1, step = 0.05, group = G_SETUP)
float breakRange = input.float(0.50, "ChoCh minimum mum araligi / grafik ATR", minval = 0, step = 0.1, group = G_SETUP)
int returnWait = input.int(12, "Disaridan donus icin grafik mum sayisi", minval = 1, maxval = 100, group = G_SETUP)
int chochWait = input.int(24, "Donusten sonra ChoCh icin grafik mum sayisi", minval = 1, maxval = 150, group = G_SETUP)
int retestWait = input.int(24, "ChoCh sonrasi retest icin grafik mum sayisi", minval = 1, maxval = 150, group = G_SETUP)
int reactionBars = input.int(3, "Ilk retest temasindan sonra tepki mum sayisi", minval = 1, maxval = 10, group = G_SETUP)
float retestHalfWidth = input.float(0.10, "Retest bandi yari genisligi / ChoCh ATR", minval = 0.01, step = 0.05, group = G_SETUP)
float maximumChase = input.float(0.50, "Tepki kapanisinin bant otesi uzakligi / ChoCh ATR", minval = 0, step = 0.1, group = G_SETUP)
int cooldownBars = input.int(12, "Tamamlanan aday sonrasi grafik mum sayisi", minval = 1, maxval = 100, group = G_SETUP)

string G_TARGET = "3. Stop hedef ve bildirim"
float stopBuffer = input.float(0.10, "Sweep ucuna stop payi / donus ATR", minval = 0, step = 0.05, group = G_TARGET)
string rrTarget = input.string("EQ", "Minimum R/R uygulanacak hedef", options = ["EQ", "Karsi sinir"], group = G_TARGET)
float minimumRR = input.float(1.50, "Minimum planlanan R/R", minval = 0.5, step = 0.25, group = G_TARGET)
string notifyMode = input.string("Hazir + iptal", "Bildirim", options = ["Hazir + iptal", "Tum asamalar", "Sadece hazir"], group = G_TARGET)
bool showRange = input.bool(true, "Sabit RH / RL / EQ", group = G_TARGET)
bool showLabels = input.bool(true, "Asama etiketleri", group = G_TARGET)

float chartSeconds = timeframe.in_seconds()
float rangeSeconds = timeframe.in_seconds(rangeTf)
if barstate.isfirst
    if not chart.is_standard or not timeframe.isintraday
        runtime.error("Standart intraday mum kullanin. Setup TF grafik TF'dir; onerilen 5m veya 15m.")
    if chartSeconds >= rangeSeconds or rangeSeconds % chartSeconds != 0
        runtime.error("Grafik TF, range TF'den kucuk olmali ve onu tam bolmeli.")
    if maximumWidth <= minimumWidth or rangeWindow <= minimumSpan + rangePivot * 2
        runtime.error("Range genisligi / pencere ayarlarini kontrol edin.")
    if not use3A and not use3C
        runtime.error("En az bir setup rotasini etkinlestirin.")

f_range_packet() =>
    float atr = ta.atr(14)
    float ph = ta.pivothigh(high, rangePivot, rangePivot)
    float pl = ta.pivotlow(low, rangePivot, rangePivot)
    // Exclude the current source candle. Once accepted, these levels never roll.
    float candidateHigh = ta.highest(high[1], rangeWindow)
    float candidateLow = ta.lowest(low[1], rangeWindow)
    float tolerance = touchTolerance * atr[1]
    var bool alive = false
    var int rangeId = na
    var int bornBar = na
    var int endedBar = na
    var float rh = na
    var float rl = na
    var int highTouches = 0
    var int lowTouches = 0
    var string status = "Yeterli temas bekleniyor"
    if alive
        if close < rl or close > rh
            alive := false
            endedBar := bar_index
            status := "HTF range disinda kapandi"
        else if bar_index - bornBar > rangeLife
            alive := false
            endedBar := bar_index
            status := "Range omru doldu"
    bool canDiscover = not alive and (na(endedBar) or bar_index - endedBar >= rediscoveryWait)
    float widthAtr = (candidateHigh - candidateLow) / atr[1]
    if canDiscover and bar_index >= rangeWindow + rangePivot and widthAtr >= minimumWidth and widthAtr <= maximumWidth and close > candidateLow and close < candidateHigh
        int highs = 0
        int lows = 0
        int newestHigh = na
        int oldestHigh = na
        int newestLow = na
        int oldestLow = na
        int lastHigh = na
        int lastLow = na
        for i = 1 to rangeWindow - rangePivot
            int offset = i + rangePivot
            if not na(ph[i]) and math.abs(ph[i] - candidateHigh) <= tolerance and (na(lastHigh) or offset - lastHigh >= touchSpacing)
                highs += 1
                newestHigh := na(newestHigh) ? offset : newestHigh
                oldestHigh := offset
                lastHigh := offset
            if not na(pl[i]) and math.abs(pl[i] - candidateLow) <= tolerance and (na(lastLow) or offset - lastLow >= touchSpacing)
                lows += 1
                newestLow := na(newestLow) ? offset : newestLow
                oldestLow := offset
                lastLow := offset
        bool durationOK = not na(oldestHigh) and not na(oldestLow) and oldestHigh - newestHigh >= minimumSpan and oldestLow - newestLow >= minimumSpan
        if highs >= minimumTouches and lows >= minimumTouches and durationOK
            alive := true
            rangeId := time_close
            bornBar := bar_index
            rh := candidateHigh
            rl := candidateLow
            highTouches := highs
            lowTouches := lows
            status := "Sabit range aktif"
    int age = na(bornBar) ? 0 : bar_index - bornBar
    [time[1], time_close[1], close[1], atr[1], rangeId[1], alive[1], rh[1], rl[1], highTouches[1], lowTouches[1], age[1], status[1]]

[hTime, hEnd, hClose, hAtr, hId, hAlive, hRH, hRL, hHighTouches, hLowTouches, hAge, hStatus] = request.security(syminfo.tickerid, rangeTf, f_range_packet(), lookahead = barmerge.lookahead_on)
bool newH = not na(hTime) and (na(hTime[1]) or hTime != hTime[1])
float atr = ta.atr(14)
int containingHtfEnd = time_close(rangeTf)

f_structure() =>
    float ph = ta.pivothigh(high, internalLen, internalLen)
    float pl = ta.pivotlow(low, internalLen, internalLen)
    var float hi = na
    var float lo = na
    var float oldHi = na
    var float oldLo = na
    var bool hiBroken = false
    var bool loBroken = false
    var int bias = 0
    bool up = not na(hi) and not hiBroken and close > hi + breakBuffer * atr
    bool down = not na(lo) and not loBroken and close < lo - breakBuffer * atr
    if up and not down
        bias := 1
    if down and not up
        bias := -1
    if up
        hiBroken := true
    if down
        loBroken := true
    if not na(ph)
        oldHi := hi
        hi := ph
        hiBroken := close > hi
    if not na(pl)
        oldLo := lo
        lo := pl
        loBroken := close < lo
    if bias == 0 and not na(oldHi) and not na(oldLo)
        bias := hi > oldHi and lo > oldLo ? 1 : hi < oldHi and lo < oldLo ? -1 : 0
    [bias, hi, lo, hiBroken, loBroken]
[internalBias, internalHigh, internalLow, internalHB, internalLB] = f_structure()

type Setup
    int side = 0
    int phase = 0
    string model = ""
    string id = ""
    string reason = "Sweep bekleniyor"
    int rangeId = na
    int createdBar = na
    int returnBar = na
    int breakBar = na
    int touchBar = na
    int technicalEnd = na
    int holdEnd = na
    int terminalBar = na
    float rh = na
    float rl = na
    float eq = na
    float extreme = na
    float stop = na
    float breakLevel = na
    float breakAtr = na
    float bandLow = na
    float bandHigh = na
    float entry = na
    float technicalPrice = na
    float rr1 = na
    float rr2 = na

var Setup s = Setup.new()
var box rangeBox = na
var int drawnRangeId = na
f_price(float v) =>
    na(v) ? "-" : str.tostring(v, format.mintick)
f_phase(int p) =>
    p == 1 ? "Range'e donus" : p == 2 ? "Onay bekliyor" : p == 3 ? "Ilk retest" : p == 4 ? "Retest tepkisi" : p == 5 ? "HTF kapanisi" : p == 6 ? "HAZIR" : p == 7 ? "IPTAL" : p == 8 ? "SURE DOLDU" : "Sweep bekliyor"
method finish(Setup x, int phase, string reason) =>
    x.phase := phase
    x.reason := reason
    x.terminalBar := bar_index
method technical(Setup x, string reason) =>
    x.phase := 5
    x.technicalEnd := time_close
    x.technicalPrice := close
    x.reason := reason
f_notice(Setup x, string event) =>
    bool send = notifyMode == "Tum asamalar" or x.phase == 6 or (notifyMode == "Hazir + iptal" and x.phase >= 7)
    string msg = syminfo.tickerid + " | " + x.model + " | " + (x.side == 1 ? "LONG" : "SHORT") + " | " + event + " | id=" + x.id + " | " + x.reason
    msg += " | RL=" + f_price(x.rl) + " | EQ=" + f_price(x.eq) + " | RH=" + f_price(x.rh)
    msg += " | giris=" + f_price(x.entry) + " | stop=" + f_price(x.stop) + " | RR_EQ=" + (na(x.rr1) ? "-" : str.tostring(x.rr1, "#.##")) + " | RR_sinir=" + (na(x.rr2) ? "-" : str.tostring(x.rr2, "#.##"))
    msg += " | grafik=" + timeframe.period + " | rangeTF=" + rangeTf + " | HTF_bekle=" + str.tostring(waitHtfClose)
    if showLabels
        label.new(bar_index, x.side == 1 ? low : high, x.model + " " + event, style = x.side == 1 ? label.style_label_up : label.style_label_down, color = x.phase == 6 ? color.teal : x.phase >= 7 ? color.gray : color.blue, textcolor = color.white, size = size.tiny)
    send ? msg + "\n" : ""

bool readyLong = false
bool readyShort = false
bool cancelled = false
bool expired = false
string messages = ""
if barstate.isconfirmed
    if newH
        if hAlive and (na(drawnRangeId) or hId != drawnRangeId)
            if not na(rangeBox)
                box.set_extend(rangeBox, extend.none)
                box.set_right(rangeBox, time)
            drawnRangeId := hId
            if showRange
                rangeBox := box.new(left = time, top = hRH, right = time_close, bottom = hRL, xloc = xloc.bar_time, extend = extend.right, border_color = color.blue, bgcolor = color.new(color.blue, 94))
        if not hAlive and hAlive[1] and not na(rangeBox)
            box.set_extend(rangeBox, extend.none)
            box.set_right(rangeBox, time)
            box.set_bgcolor(rangeBox, color.new(color.gray, 96))

    bool active = s.phase >= 1 and s.phase <= 5
    if active and bar_index > s.createdBar
        bool rangeLost = not hAlive or hId != s.rangeId
        bool extremeLost = s.phase >= 2 and (s.side == 1 ? low < s.extreme : high > s.extreme)
        bool returnLost = s.phase >= 2 and (close <= s.rl or close >= s.rh)
        bool eqHit = s.side == 1 ? high >= s.eq : low <= s.eq
        bool bothSides = low < s.rl and high > s.rh
        bool timedOut = s.phase == 1 ? bar_index - s.createdBar > returnWait : s.phase == 2 and s.model == "3A" ? bar_index - s.returnBar > chochWait : s.phase == 3 ? bar_index - s.breakBar > retestWait : s.phase == 4 ? bar_index - s.touchBar >= reactionBars : s.phase == 5 ? time > s.technicalEnd + 2 * rangeSeconds * 1000 : false
        if rangeLost or extremeLost or returnLost or eqHit or bothSides
            s.finish(7, rangeLost ? "Range HTF kapanisiyla kaybedildi / omru doldu" : extremeLost ? "Donus sonrasi sweep ucu yeniden ihlal edildi" : returnLost ? "Geri donus sonrasi range disinda kapanis" : eqHit ? "Giris oncesinde ilk hedef EQ goruldu" : "Ayni mum iki range sinirini supurdu")
            cancelled := true
            messages += f_notice(s, "IPTAL")
        else if timedOut
            s.finish(8, "Bu asamanin bekleme suresi doldu")
            expired := true
            messages += f_notice(s, "SURE DOLDU")
        else
            if s.phase == 1
                s.extreme := s.side == 1 ? math.min(s.extreme, low) : math.max(s.extreme, high)
                if close > s.rl and close < s.rh
                    float reference = s.side == 1 ? internalHigh[1] : internalLow[1]
                    bool intact = s.side == 1 ? not internalHB[1] : not internalLB[1]
                    bool notPassed = (reference - close) * s.side > 0
                    bool firstTargetSeen = s.side == 1 ? high >= s.eq : low <= s.eq
                    if internalBias[1] == -s.side and intact and not na(reference) and notPassed and not firstTargetSeen
                        s.phase := 2
                        s.returnBar := bar_index
                        s.holdEnd := containingHtfEnd
                        s.stop := s.extreme - s.side * math.max(stopBuffer * atr, syminfo.mintick)
                        s.breakLevel := reference
                        s.reason := "Range'e donus; sabit karsi internal seviyede ChoCh bekleniyor"
                        messages += f_notice(s, "GERI DONUS")
                    else
                        s.finish(7, firstTargetSeen ? "Donus mumunda EQ goruldu" : "Donuste ters internal yapi / kirilmamis ChoCh esigi yok")
                        cancelled := true
                        messages += f_notice(s, "IPTAL")

            if s.phase == 2 and s.model == "3C"
                // Exactly the next chart candle, not any later green/red candle.
                if bar_index == s.createdBar + 1 and (close - open) * s.side > 0
                    s.technical("SFP sonrasi ilk mum yonlu kapandi")
                    messages += f_notice(s, "TEKNIK ONAY")
                else
                    s.finish(7, "SFP sonrasi ilk mum yonlu onay vermedi")
                    cancelled := true
                    messages += f_notice(s, "IPTAL")

            if s.phase == 2 and s.model == "3A" and bar_index > s.returnBar
                bool cross = s.side == 1 ? close > s.breakLevel and close[1] <= s.breakLevel : close < s.breakLevel and close[1] >= s.breakLevel
                if cross
                    float body = math.abs(close - open) / math.max(high - low, syminfo.mintick)
                    bool strong = (close - open) * s.side > 0 and body >= breakBody and high - low >= breakRange * atr and (close - s.breakLevel) * s.side >= breakBuffer * atr
                    if strong
                        s.phase := 3
                        s.breakBar := bar_index
                        s.breakAtr := atr
                        s.bandLow := s.breakLevel - retestHalfWidth * atr
                        s.bandHigh := s.breakLevel + retestHalfWidth * atr
                        s.reason := "ChoCh teyit edildi; ilk retest bekleniyor"
                        messages += f_notice(s, "CHOCH")
                    else
                        s.finish(7, "Ilk yapi gecisi ChoCh govde / aralik sartini saglamadi")
                        cancelled := true
                        messages += f_notice(s, "IPTAL")

            if s.phase == 3 and bar_index > s.breakBar and low <= s.bandHigh and high >= s.bandLow
                s.phase := 4
                s.touchBar := bar_index
                s.reason := "Ilk retest temasi"
                messages += f_notice(s, "RETEST")
            if s.phase == 4
                bool bandLost = s.side == 1 ? close < s.bandLow : close > s.bandHigh
                bool held = (close - s.breakLevel) * s.side > 0 and (close - open) * s.side > 0
                bool tooFar = s.side == 1 ? close > s.bandHigh + maximumChase * s.breakAtr : close < s.bandLow - maximumChase * s.breakAtr
                if bandLost or tooFar
                    s.finish(7, bandLost ? "Ilk retest bandi kapanisla kaybedildi" : "Retest kapanisi banttan fazla uzak")
                    cancelled := true
                    messages += f_notice(s, "IPTAL")
                else if held
                    s.technical("Ilk retest tepkisi teyit edildi")
                    messages += f_notice(s, "TEKNIK ONAY")

            if s.phase == 5
                bool holdConfirmed = not waitHtfClose or (hEnd >= s.holdEnd and hAlive and hId == s.rangeId)
                if holdConfirmed
                    float risk = (close - s.stop) * s.side
                    float reward1 = (s.eq - close) * s.side
                    float reward2 = ((s.side == 1 ? s.rh : s.rl) - close) * s.side
                    s.entry := close
                    s.rr1 := risk > 0 ? reward1 / risk : na
                    s.rr2 := risk > 0 ? reward2 / risk : na
                    float selectedRR = rrTarget == "EQ" ? s.rr1 : s.rr2
                    if risk > 0 and reward1 > 0 and selectedRR >= minimumRR
                        bool delayed = time_close > s.technicalEnd
                        s.finish(6, delayed ? "HTF kapanisi korundu; alarm kapanisiyla R/R yenilendi" : waitHtfClose ? "Teknik onay ve HTF kapanis kosulu tamam" : "Teknik onay tamam; gelismekte olan HTF kapanisi beklenmedi")
                        readyLong := s.side == 1
                        readyShort := s.side == -1
                        messages += f_notice(s, "HAZIR")
                    else
                        s.finish(7, "Alarm kapanisinda hedef yonu veya minimum R/R uygun degil")
                        cancelled := true
                        messages += f_notice(s, "IPTAL")

    bool available = s.phase == 0 or (s.phase >= 6 and bar_index - s.terminalBar >= cooldownBars)
    bool previouslyInside = close[1] > hRL and close[1] < hRH
    if available and hAlive and not na(atr) and previouslyInside
        float minSweep = math.max(sweepMinimum * atr, syminfo.mintick)
        bool sweptLow = low < hRL - minSweep
        bool sweptHigh = high > hRH + minSweep
        int side = sweptLow and not sweptHigh ? 1 : sweptHigh and not sweptLow ? -1 : 0
        bool directionOK = directionInput == "Iki yon" or (side == 1 and directionInput == "Long") or (side == -1 and directionInput == "Short")
        bool closedInside = close > hRL and close < hRH
        bool bodyInside = open >= hRL and open <= hRH and closedInside
        bool closedOutside = side == 1 ? close < hRL : close > hRH
        bool sfp = side != 0 and bodyInside and use3C
        bool deviation = side != 0 and closedOutside and use3A
        bool bothBoundaries = low < hRL and high > hRH
        bool targetUntouched = side == 1 ? high < (hRH + hRL) / 2 : low > (hRH + hRL) / 2
        if directionOK and not bothBoundaries and targetUntouched and (sfp or deviation)
            s.side := side
            s.model := sfp ? "3C" : "3A"
            s.phase := sfp ? 2 : 1
            s.id := s.model + "-" + str.tostring(hId) + "-" + str.tostring(time_close) + "-" + str.tostring(side)
            s.rangeId := hId
            s.reason := sfp ? "SFP tespit edildi; hemen sonraki grafik mumu bekleniyor" : "Range disinda kapanis; iceri donus bekleniyor"
            s.createdBar := bar_index
            s.returnBar := sfp ? bar_index : na
            s.breakBar := na
            s.touchBar := na
            s.technicalEnd := na
            s.holdEnd := sfp ? containingHtfEnd : na
            s.rh := hRH
            s.rl := hRL
            s.eq := (hRH + hRL) / 2
            s.extreme := side == 1 ? low : high
            s.stop := sfp ? s.extreme - side * math.max(stopBuffer * atr, syminfo.mintick) : na
            s.breakLevel := na
            s.breakAtr := na
            s.bandLow := na
            s.bandHigh := na
            s.entry := na
            s.technicalPrice := na
            s.rr1 := na
            s.rr2 := na
            messages += f_notice(s, sfp ? "SFP" : "SAPMA")
    if str.length(messages) > 0
        alert(messages, alert.freq_once_per_bar_close)

bool setupActive = s.phase >= 1 and s.phase <= 5
float eq = (hRH + hRL) / 2
plot(showRange and hAlive ? hRH : na, "RH", color = color.orange, style = plot.style_linebr, linewidth = 2)
plot(showRange and hAlive ? hRL : na, "RL", color = color.teal, style = plot.style_linebr, linewidth = 2)
plot(showRange and hAlive ? eq : na, "EQ / TP1", color = color.gray, style = plot.style_linebr)
plot(setupActive ? s.stop : na, "Setup stop", color = color.red, style = plot.style_linebr)
plot(setupActive ? s.breakLevel : na, "3A ChoCh seviyesi", color = color.yellow, style = plot.style_linebr)
plot(setupActive ? s.bandLow : na, "3A retest alt", color = color.new(color.yellow, 50), style = plot.style_linebr)
plot(setupActive ? s.bandHigh : na, "3A retest ust", color = color.new(color.yellow, 50), style = plot.style_linebr)
plotshape(readyLong, "Range Long", shape.triangleup, location.belowbar, color.teal, size = size.small, text = "R")
plotshape(readyShort, "Range Short", shape.triangledown, location.abovebar, color.orange, size = size.small, text = "R")
alertcondition(readyLong, "3A/3C Long hazir", "RANGE LONG | {{ticker}} | {{interval}} | close={{close}}")
alertcondition(readyShort, "3A/3C Short hazir", "RANGE SHORT | {{ticker}} | {{interval}} | close={{close}}")
alertcondition(cancelled, "Range setup iptal", "RANGE IPTAL | {{ticker}}")
alertcondition(expired, "Range setup suresi doldu", "RANGE SURE DOLDU | {{ticker}}")

var table panel = table.new(position.bottom_right, 2, 10, bgcolor = color.new(color.black, 15), border_width = 1)
if barstate.islast
    table.cell(panel, 0, 0, "Range " + rangeTf + " / grafik " + timeframe.period, text_color = color.white)
    table.cell(panel, 1, 0, hStatus, text_color = color.white)
    table.cell(panel, 0, 1, "RL / EQ / RH", text_color = color.white)
    table.cell(panel, 1, 1, f_price(hRL) + " / " + f_price(eq) + " / " + f_price(hRH), text_color = color.white)
    table.cell(panel, 0, 2, "RL / RH ilk temas sayisi", text_color = color.white)
    table.cell(panel, 1, 2, str.tostring(hLowTouches) + " / " + str.tostring(hHighTouches) + " | yas " + str.tostring(hAge), text_color = color.white)
    table.cell(panel, 0, 3, "Model / asama", text_color = color.white)
    table.cell(panel, 1, 3, s.model + " " + (s.side == 1 ? "LONG " : s.side == -1 ? "SHORT " : "") + f_phase(s.phase), text_color = color.white)
    table.cell(panel, 0, 4, "Giris / stop", text_color = color.white)
    table.cell(panel, 1, 4, f_price(s.entry) + " / " + f_price(s.stop), text_color = color.white)
    table.cell(panel, 0, 5, "EQ RR / sinir RR", text_color = color.white)
    table.cell(panel, 1, 5, (na(s.rr1) ? "-" : str.tostring(s.rr1, "#.##")) + " / " + (na(s.rr2) ? "-" : str.tostring(s.rr2, "#.##")), text_color = color.white)
    table.cell(panel, 0, 6, "HTF teyidi", text_color = color.white)
    table.cell(panel, 1, 6, waitHtfClose ? "Sweep / donus HTF kapanisi beklenecek" : "Gelismekte olan HTF kapanisi beklenmez", text_color = color.white)
    table.cell(panel, 0, 7, "Teknik onay fiyati", text_color = color.white)
    table.cell(panel, 1, 7, f_price(s.technicalPrice), text_color = color.white)
    table.cell(panel, 0, 8, "Neden", text_color = color.white)
    table.cell(panel, 1, 8, s.reason, text_color = color.white, text_size = size.tiny)
    table.cell(panel, 0, 9, notifyMode, text_color = color.white)
    table.cell(panel, 1, 9, "Min RR " + rrTarget + ": " + str.tostring(minimumRR), text_color = color.white)
