//@version=6
indicator("MPA | 1A HTF Pullback v0.1", overlay = true, max_bars_back = 600, max_boxes_count = 80, max_labels_count = 150)

// Standalone alert indicator. See pullback_range.md for definitions and limitations.
string G_TF = "1. Zaman dilimleri"
string biasTf = input.timeframe("1D", "Ana trend", options = ["1D", "1W"], group = G_TF)
string zoneTf = input.timeframe("240", "Demand / supply", options = ["120", "240", "1D"], group = G_TF)
string confirmTf = input.timeframe("45", "ChoCh", options = ["15", "30", "45", "60"], group = G_TF)
int swingLen = input.int(5, "HTF swing pivot sol / sag", minval = 2, maxval = 15, group = G_TF)
int internalLen = input.int(2, "ChoCh pivot sol / sag", minval = 1, maxval = 8, group = G_TF)
int triggerLen = input.int(2, "Grafikte HL / LH pivot sol / sag", minval = 1, maxval = 8, group = G_TF)
float breakBuffer = input.float(0.05, "Yapi kirilim payi / kaynak ATR", minval = 0, step = 0.05, group = G_TF)

string G_ZONE = "2. Otomatik bolge"
int originLookback = input.int(20, "BOS oncesi ters mum arama", minval = 2, maxval = 60, group = G_ZONE)
float impulseMin = input.float(1.5, "Minimum impuls genisligi / HTF ATR", minval = 0.5, step = 0.25, group = G_ZONE)
float bosBodyMin = input.float(0.50, "BOS minimum govde / mum araligi", minval = 0.1, maxval = 1, step = 0.05, group = G_ZONE)
int maxVisits = input.int(2, "Bolgeye izin verilen ziyaret: 1=taze, 2=bir kez testli", minval = 1, maxval = 2, group = G_ZONE)
int rearmBars = input.int(3, "Yeni ziyaret icin tamamen bolge disinda mum sayisi", minval = 1, maxval = 20, group = G_ZONE)
int zoneLife = input.int(60, "Bolge omru: HTF mum suresi", minval = 3, maxval = 300, group = G_ZONE)
bool rejectInsideClose = input.bool(true, "HTF bolge icinde kapanirsa bolgeyi iptal et", group = G_ZONE)
string retracementMode = input.string("Discount / premium", "Bolge ile kesisim", options = ["Discount / premium", "Yalniz OTE"], group = G_ZONE)
string directionInput = input.string("Iki yon", "Yon", options = ["Iki yon", "Long", "Short"], group = G_ZONE)

string G_ENTRY = "3. Onay ve hedef"
int chochWait = input.int(8, "Temastan sonra ChoCh: onay TF mum suresi", minval = 1, maxval = 48, group = G_ENTRY)
int hlWait = input.int(24, "ChoCh sonrasi HL / LH: grafik mumu", minval = 3, maxval = 200, group = G_ENTRY)
float chochBodyMin = input.float(0.50, "ChoCh minimum govde / mum araligi", minval = 0.1, maxval = 1, step = 0.05, group = G_ENTRY)
float stopBuffer = input.float(0.05, "HTF bolge ucuna stop payi / HTF ATR", minval = 0, step = 0.05, group = G_ENTRY)
float minimumRR = input.float(1.50, "Impuls ucuna minimum planlanan R/R", minval = 0.5, step = 0.25, group = G_ENTRY)
int cooldownBars = input.int(12, "Setup sonrasi bekleme: grafik mumu", minval = 1, group = G_ENTRY)
string notifyMode = input.string("Hazir + iptal", "Bildirim", options = ["Hazir + iptal", "Tum asamalar", "Sadece hazir"], group = G_ENTRY)
bool showZones = input.bool(true, "Bolge kutulari", group = G_ENTRY)
bool showLabels = input.bool(true, "Asama etiketleri", group = G_ENTRY)

float chartSeconds = timeframe.in_seconds()
float zoneSeconds = timeframe.in_seconds(zoneTf)
float confirmSeconds = timeframe.in_seconds(confirmTf)
float biasSeconds = timeframe.in_seconds(biasTf)
if barstate.isfirst
    if not chart.is_standard or not timeframe.isintraday
        runtime.error("Standart intraday mum kullanin. Varsayilan tetik grafigi 5m.")
    if chartSeconds >= confirmSeconds or confirmSeconds >= zoneSeconds or zoneSeconds >= biasSeconds
        runtime.error("Grafik < ChoCh TF < Bolge TF < Ana trend TF olmali.")
    if confirmSeconds % chartSeconds != 0 or zoneSeconds % chartSeconds != 0 or biasSeconds % chartSeconds != 0
        runtime.error("Grafik TF secili tum TF'leri tam bolmeli. Varsayilanlarla 5m veya 15m kullanin.")

// The break uses levels known before this source bar's newly confirmed pivots.
f_structure(int length, float atr) =>
    float ph = ta.pivothigh(high, length, length)
    float pl = ta.pivotlow(low, length, length)
    var float hi = na
    var float lo = na
    var float previousHi = na
    var float previousLo = na
    var int hiTime = na
    var int loTime = na
    var bool hiBroken = false
    var bool loBroken = false
    var int bias = 0
    float anchorHi = hi
    float anchorLo = lo
    int anchorHiTime = hiTime
    int anchorLoTime = loTime
    bool up = not na(hi) and not hiBroken and close > hi + breakBuffer * atr
    bool down = not na(lo) and not loBroken and close < lo - breakBuffer * atr
    int event = 0
    if up and not down
        event := bias == 1 ? 1 : bias == -1 ? 2 : 3
        bias := 1
    if down and not up
        event := bias == -1 ? -1 : bias == 1 ? -2 : -3
        bias := -1
    if up
        hiBroken := true
    if down
        loBroken := true
    if not na(ph)
        previousHi := hi
        hi := ph
        hiTime := time[length]
        hiBroken := close > hi
    if not na(pl)
        previousLo := lo
        lo := pl
        loTime := time[length]
        loBroken := close < lo
    if bias == 0 and not na(previousHi) and not na(previousLo)
        bias := hi > previousHi and lo > previousLo ? 1 : hi < previousHi and lo < previousLo ? -1 : 0
    [bias, hi, lo, hiBroken, loBroken, event, anchorHi, anchorLo, anchorHiTime, anchorLoTime]

f_bias_packet(int length) =>
    float atr = ta.atr(14)
    [b, hi, lo, hb, lb, ev, ah, al, aht, alt] = f_structure(length, atr)
    [time[1], time_close[1], open[1], high[1], low[1], close[1], close[2], atr[1], b[1], hi[1], lo[1], hb[1], lb[1]]

f_zone_packet() =>
    float atr = ta.atr(14)
    [b, hi, lo, hb, lb, ev, ah, al, aht, alt] = f_structure(swingLen, atr)
    int side = ev == 1 ? 1 : ev == -1 ? -1 : 0
    float bottom = na
    float top = na
    float impulseLow = side == 1 ? al : low
    float impulseHigh = side == 1 ? high : ah
    int origin = na
    float bodyRatio = math.abs(close - open) / math.max(high - low, syminfo.mintick)
    bool valid = side != 0 and bodyRatio >= bosBodyMin and (close - open) * side > 0 and impulseHigh - impulseLow >= impulseMin * atr
    if valid
        for i = 1 to originLookback
            bool opposite = side == 1 ? close[i] < open[i] : close[i] > open[i]
            bool afterAnchor = side == 1 ? time[i] >= alt : time[i] >= aht
            if opposite and afterAnchor
                bottom := low[i]
                top := high[i]
                origin := i
                break
        valid := not na(origin)
    // Reject origins already revisited on HTF bars after an HTF close left the zone.
    // The departure candle itself is formation, not a retest. No hidden LTF history is inferred.
    if valid
        bool departed = false
        bool revisited = false
        bool lost = false
        for i = origin - 1 to 0
            if departed and low[i] <= top and high[i] >= bottom
                revisited := true
            if (side == 1 and close[i] < bottom) or (side == -1 and close[i] > top)
                lost := true
            if (side == 1 and close[i] > top) or (side == -1 and close[i] < bottom)
                departed := true
        valid := departed and not revisited and not lost and bottom >= impulseLow and top <= impulseHigh
    int zoneSide = valid ? side : 0
    [time[1], time_close[1], close[1], atr[1], b[1], zoneSide[1], bottom[1], top[1], impulseLow[1], impulseHigh[1]]

[dTime, dEnd, dOpen, dHigh, dLow, dClose, dPrev, dAtr, dBias, dHi, dLo, dHB, dLB] = request.security(syminfo.tickerid, biasTf, f_bias_packet(swingLen), lookahead = barmerge.lookahead_on)
[hTime, hEnd, hClose, hAtr, hBias, hZoneSide, hBottom, hTop, hImpulseLow, hImpulseHigh] = request.security(syminfo.tickerid, zoneTf, f_zone_packet(), lookahead = barmerge.lookahead_on)
[cTime, cEnd, cOpen, cHigh, cLow, cClose, cPrev, cAtr, cBias, cHi, cLo, cHB, cLB] = request.security(syminfo.tickerid, confirmTf, f_bias_packet(internalLen), lookahead = barmerge.lookahead_on)
bool newH = not na(hTime) and (na(hTime[1]) or hTime != hTime[1])
bool newC = not na(cTime) and (na(cTime[1]) or cTime != cTime[1])
float triggerLow = ta.pivotlow(low, triggerLen, triggerLen)
float triggerHigh = ta.pivothigh(high, triggerLen, triggerLen)

type Zone
    int side = 0
    int sourceEnd = na
    float bottom = na
    float top = na
    float impulseLow = na
    float impulseHigh = na
    float atr = na
    int visits = 0
    int awayBars = 0
    bool visitOpen = false
    bool alive = false
    bool used = false
    box area = na

type Setup
    int side = 0
    int phase = 0
    string id = ""
    string reason = "Temas bekleniyor"
    int createdBar = na
    int touchEnd = na
    int breakEnd = na
    int breakBar = na
    int terminalBar = na
    float bottom = na
    float top = na
    float fibLow = na
    float fibHigh = na
    float breakLevel = na
    float pullbackExtreme = na
    float stop = na
    float target = na
    float entry = na
    float rr = na

var array<Zone> zones = array.from(Zone.new(side = 1), Zone.new(side = -1))
var array<Setup> setups = array.from(Setup.new(side = 1), Setup.new(side = -1))
f_price(float v) =>
    na(v) ? "-" : str.tostring(v, format.mintick)
f_bias(int b) =>
    b == 1 ? "Bullish" : b == -1 ? "Bearish" : "Belirsiz"
f_phase(int p) =>
    p == 1 ? "ChoCh " + confirmTf + " bekliyor" : p == 2 ? "HL/LH bekliyor" : p == 3 ? "HAZIR" : p == 4 ? "IPTAL" : p == 5 ? "SURE DOLDU" : "Temas bekliyor"
method finish(Setup s, int phase, string reason) =>
    s.phase := phase
    s.reason := reason
    s.terminalBar := bar_index
f_notice(Setup s, string event) =>
    bool terminal = s.phase >= 3
    bool send = notifyMode == "Tum asamalar" or s.phase == 3 or (notifyMode == "Hazir + iptal" and terminal)
    string msg = syminfo.tickerid + " | 1A | " + (s.side == 1 ? "LONG" : "SHORT") + " | " + event + " | id=" + s.id + " | " + s.reason
    msg += " | bolge=" + f_price(s.bottom) + ":" + f_price(s.top) + " | choch=" + f_price(s.breakLevel)
    msg += " | giris=" + f_price(s.entry) + " | stop=" + f_price(s.stop) + " | hedef=" + f_price(s.target) + " | RR=" + (na(s.rr) ? "-" : str.tostring(s.rr, "#.##"))
    msg += " | TF=" + timeframe.period + "/" + confirmTf + "/" + zoneTf + "/" + biasTf
    if showLabels
        label.new(bar_index, s.side == 1 ? low : high, "1A " + event, style = s.side == 1 ? label.style_label_up : label.style_label_down, color = s.phase == 3 ? color.teal : s.phase >= 4 ? color.gray : color.blue, textcolor = color.white, size = size.tiny)
    send ? msg + "\n" : ""

bool readyLong = false
bool readyShort = false
bool cancelled = false
bool expired = false
string messages = ""
if barstate.isconfirmed
    for idx = 0 to 1
        Zone z = array.get(zones, idx)
        Setup s = array.get(setups, idx)
        int side = s.side
        // A setup owns its snapshot; replacing the latest zone cannot move an active setup.
        if newH and hZoneSide == side
            if not na(z.area)
                box.set_extend(z.area, extend.none)
                box.set_right(z.area, time)
            z.sourceEnd := hEnd
            z.bottom := hBottom
            z.top := hTop
            z.impulseLow := hImpulseLow
            z.impulseHigh := hImpulseHigh
            z.atr := hAtr
            z.visits := 0
            z.awayBars := rearmBars
            z.visitOpen := false
            z.alive := true
            z.used := false
            if showZones
                z.area := box.new(left = time, top = z.top, right = time_close, bottom = z.bottom, xloc = xloc.bar_time, extend = extend.right, border_color = side == 1 ? color.teal : color.orange, bgcolor = color.new(side == 1 ? color.teal : color.orange, 88))
        if z.alive
            float invalidLevel = side == 1 ? (rejectInsideClose ? z.top : z.bottom) : (rejectInsideClose ? z.bottom : z.top)
            bool closeLost = newH and hEnd > z.sourceEnd and (side == 1 ? hClose <= invalidLevel : hClose >= invalidLevel)
            bool tooOld = time_close > z.sourceEnd + zoneLife * zoneSeconds * 1000
            if closeLost or tooOld
                z.alive := false
                if not na(z.area)
                    box.set_extend(z.area, extend.none)
                    box.set_right(z.area, time_close)
                    box.set_bgcolor(z.area, color.new(color.gray, 94))

        if s.phase == 1 or s.phase == 2
            float invalidLevel = side == 1 ? (rejectInsideClose ? s.top : s.bottom) : (rejectInsideClose ? s.bottom : s.top)
            bool closeLost = newH and hEnd >= s.touchEnd and (side == 1 ? hClose <= invalidLevel : hClose >= invalidLevel)
            bool distalLost = side == 1 ? low < s.bottom : high > s.top
            bool trendLost = dBias != side or hBias != side
            bool targetHit = side == 1 ? high >= s.target : low <= s.target
            bool baselineLost = s.phase == 2 and (side == 1 ? low < s.pullbackExtreme : high > s.pullbackExtreme)
            int deadline = s.touchEnd + int(chochWait * confirmSeconds * 1000)
            bool timelyPacket = s.phase == 1 and newC and cTime >= s.touchEnd and cEnd <= deadline
            bool timedOut = s.phase == 1 ? time_close > deadline and not timelyPacket : bar_index - s.breakBar > hlWait
            if closeLost or distalLost or trendLost or targetHit or baselineLost
                s.finish(4, closeLost ? "HTF bolge kapanisi kaybedildi" : distalLost ? "Bolge distal ucu ihlal edildi" : trendLost ? "Daily / HTF trend uyumu bozuldu" : targetHit ? "Giris oncesinde hedefe ulasildi" : "ChoCh sonrasi pullback ucu kaybedildi")
                cancelled := true
                messages += f_notice(s, "IPTAL")
            else if timedOut
                s.finish(5, s.phase == 1 ? "ChoCh bekleme suresi doldu" : "HL / LH bekleme suresi doldu")
                expired := true
                messages += f_notice(s, "SURE DOLDU")
            else
                bool cross = s.phase == 1 and newC and cTime >= s.touchEnd and cEnd <= deadline and (side == 1 ? cClose > s.breakLevel and cPrev <= s.breakLevel : cClose < s.breakLevel and cPrev >= s.breakLevel)
                if s.phase == 1 and not cross
                    s.pullbackExtreme := side == 1 ? math.min(s.pullbackExtreme, low) : math.max(s.pullbackExtreme, high)
                if cross
                    float body = math.abs(cClose - cOpen) / math.max(cHigh - cLow, syminfo.mintick)
                    bool strong = (cClose - cOpen) * side > 0 and body >= chochBodyMin and (cClose - s.breakLevel) * side >= breakBuffer * cAtr
                    if strong
                        s.phase := 2
                        s.breakEnd := cEnd
                        s.breakBar := bar_index
                        s.reason := "Sabit karsi yapi seviyesi kazanildi; yeni HL / LH bekleniyor"
                        messages += f_notice(s, "CHOCH")
                    else
                        s.finish(4, "Ilk ChoCh gecisi govde / kapanis payini saglamadi")
                        cancelled := true
                        messages += f_notice(s, "IPTAL")
                // A pivot is actionable on its confirmation bar, never on its historical origin bar.
                if s.phase == 2
                    float pivot = side == 1 ? triggerLow : triggerHigh
                    bool laterPivot = not na(pivot) and time[triggerLen] >= s.breakEnd
                    bool postBreakLost = time >= s.breakEnd and (side == 1 ? low < s.pullbackExtreme : high > s.pullbackExtreme)
                    if postBreakLost
                        s.finish(4, "ChoCh teyidinin alindigi mumda pullback ucu kaybedildi")
                        cancelled := true
                        messages += f_notice(s, "IPTAL")
                    else if laterPivot
                        bool higherLower = (pivot - s.pullbackExtreme) * side > 0
                        float risk = (close - s.stop) * side
                        float reward = (s.target - close) * side
                        s.entry := close
                        s.rr := risk > 0 ? reward / risk : na
                        if higherLower and (close - pivot) * side > 0 and reward > 0 and risk > 0 and s.rr >= minimumRR
                            s.finish(3, side == 1 ? "ChoCh sonrasi ilk HL teyit edildi" : "ChoCh sonrasi ilk LH teyit edildi")
                            readyLong := readyLong or side == 1
                            readyShort := readyShort or side == -1
                            messages += f_notice(s, "HAZIR")
                        else
                            s.finish(4, not higherLower ? "Ilk pivot HL / LH degil" : "HL / LH teyidinde giris veya R/R uygun degil")
                            cancelled := true
                            messages += f_notice(s, "IPTAL")

        if z.alive
            bool zoneTouch = low <= z.top and high >= z.bottom
            bool closedAway = side == 1 ? close > z.top : close < z.bottom
            bool newVisit = zoneTouch and not z.visitOpen
            if newVisit
                z.visits += 1
                z.visitOpen := true
                z.awayBars := 0
            if z.visitOpen
                z.awayBars := closedAway and not zoneTouch ? z.awayBars + 1 : 0
                if z.awayBars >= rearmBars
                    z.visitOpen := false
            float width = z.impulseHigh - z.impulseLow
            float eq = (z.impulseHigh + z.impulseLow) / 2
            float fibLow = retracementMode == "Yalniz OTE" ? (side == 1 ? z.impulseHigh - 0.786 * width : z.impulseLow + 0.618 * width) : (side == 1 ? z.impulseLow : eq)
            float fibHigh = retracementMode == "Yalniz OTE" ? (side == 1 ? z.impulseHigh - 0.618 * width : z.impulseLow + 0.786 * width) : (side == 1 ? eq : z.impulseHigh)
            float overlapLow = math.max(z.bottom, fibLow)
            float overlapHigh = math.min(z.top, fibHigh)
            bool overlapTouch = overlapHigh > overlapLow and low <= overlapHigh and high >= overlapLow
            bool available = s.phase == 0 or (s.phase >= 3 and bar_index - s.terminalBar >= cooldownBars)
            bool directionOK = directionInput == "Iki yon" or (side == 1 and directionInput == "Long") or (side == -1 and directionInput == "Short")
            float reference = side == 1 ? cHi : cLo
            bool intactReference = side == 1 ? not cHB : not cLB
            bool notPassed = side == 1 ? close < reference and cClose < reference : close > reference and cClose > reference
            bool distalHeld = side == 1 ? low >= z.bottom : high <= z.top
            bool targetUntouched = side == 1 ? high < z.impulseHigh : low > z.impulseLow
            bool readyData = not na(cAtr) and not na(dAtr) and not na(reference)
            // Qualifying contact can occur later within the same visit, but never after its quota.
            if available and not z.used and z.visits <= maxVisits and overlapTouch and directionOK and readyData and dBias == side and hBias == side and cBias == -side and intactReference and notPassed and distalHeld and targetUntouched
                z.used := true
                s.phase := 1
                s.id := "1A-" + str.tostring(z.sourceEnd) + "-" + str.tostring(side) + "-" + str.tostring(time_close)
                s.reason := "HTF bolge + " + retracementMode + " temasi; ChoCh bekleniyor"
                s.createdBar := bar_index
                s.touchEnd := time_close
                s.breakEnd := na
                s.breakBar := na
                s.bottom := z.bottom
                s.top := z.top
                s.fibLow := overlapLow
                s.fibHigh := overlapHigh
                s.breakLevel := reference
                s.pullbackExtreme := side == 1 ? low : high
                s.stop := (side == 1 ? z.bottom : z.top) - side * math.max(z.atr * stopBuffer, syminfo.mintick)
                s.target := side == 1 ? z.impulseHigh : z.impulseLow
                s.entry := na
                s.rr := na
                messages += f_notice(s, "TEMAS")

    if str.length(messages) > 0
        alert(messages, alert.freq_once_per_bar_close)

Setup longSetup = array.get(setups, 0)
Setup shortSetup = array.get(setups, 1)
bool activeLong = longSetup.phase == 1 or longSetup.phase == 2
bool activeShort = shortSetup.phase == 1 or shortSetup.phase == 2
plot(activeLong ? longSetup.breakLevel : na, "Long ChoCh", color = color.teal, style = plot.style_linebr)
plot(activeShort ? shortSetup.breakLevel : na, "Short ChoCh", color = color.orange, style = plot.style_linebr)
plot(activeLong ? longSetup.stop : activeShort ? shortSetup.stop : na, "Aktif stop", color = color.red, style = plot.style_linebr)
plot(activeLong ? longSetup.target : activeShort ? shortSetup.target : na, "Aktif hedef", color = color.green, style = plot.style_linebr)
plot(activeLong ? longSetup.fibLow : activeShort ? shortSetup.fibLow : na, "Kesisim alt", color = color.new(color.blue, 40), style = plot.style_linebr)
plot(activeLong ? longSetup.fibHigh : activeShort ? shortSetup.fibHigh : na, "Kesisim ust", color = color.new(color.blue, 40), style = plot.style_linebr)
plotshape(readyLong, "1A Long", shape.triangleup, location.belowbar, color.teal, size = size.small, text = "1A")
plotshape(readyShort, "1A Short", shape.triangledown, location.abovebar, color.orange, size = size.small, text = "1A")
alertcondition(readyLong, "1A Long hazir", "1A LONG | {{ticker}} | {{interval}} | close={{close}}")
alertcondition(readyShort, "1A Short hazir", "1A SHORT | {{ticker}} | {{interval}} | close={{close}}")
alertcondition(cancelled, "1A iptal", "1A IPTAL | {{ticker}}")
alertcondition(expired, "1A suresi doldu", "1A SURE DOLDU | {{ticker}}")

var table panel = table.new(position.top_right, 3, 9, bgcolor = color.new(color.black, 15), border_width = 1)
if barstate.islast
    table.cell(panel, 0, 0, "1A Pullback", text_color = color.white)
    table.cell(panel, 1, 0, "LONG", text_color = color.teal)
    table.cell(panel, 2, 0, "SHORT", text_color = color.orange)
    table.cell(panel, 0, 1, "Bias " + biasTf + " / " + zoneTf + " / " + confirmTf, text_color = color.white)
    table.cell(panel, 1, 1, f_bias(dBias) + " / " + f_bias(hBias), text_color = color.white)
    table.cell(panel, 2, 1, f_bias(cBias), text_color = color.white)
    for idx = 0 to 1
        Setup s = array.get(setups, idx)
        Zone z = array.get(zones, idx)
        int col = idx + 1
        table.cell(panel, col, 2, f_phase(s.phase), text_color = color.white)
        table.cell(panel, col, 3, z.alive ? f_price(z.bottom) + " / " + f_price(z.top) : "Aktif bolge yok", text_color = color.white)
        table.cell(panel, col, 4, str.tostring(z.visits) + "/" + str.tostring(maxVisits) + (z.used ? " | kullanildi" : ""), text_color = color.white)
        table.cell(panel, col, 5, f_price(s.stop) + " / " + f_price(s.target), text_color = color.white)
        table.cell(panel, col, 6, f_price(s.entry) + " | " + (na(s.rr) ? "-" : str.tostring(s.rr, "#.##")), text_color = color.white)
        table.cell(panel, col, 7, s.reason, text_color = color.white, text_size = size.tiny)
    table.cell(panel, 0, 2, "Asama", text_color = color.white)
    table.cell(panel, 0, 3, "Son bolge", text_color = color.white)
    table.cell(panel, 0, 4, "Ziyaret", text_color = color.white)
    table.cell(panel, 0, 5, "Stop / hedef", text_color = color.white)
    table.cell(panel, 0, 6, "Giris / RR", text_color = color.white)
    table.cell(panel, 0, 7, "Neden", text_color = color.white)
    table.cell(panel, 0, 8, "Grafik: " + timeframe.period, text_color = color.white)
    table.cell(panel, 1, 8, notifyMode, text_color = color.white)
    table.cell(panel, 2, 8, retracementMode, text_color = color.white)
